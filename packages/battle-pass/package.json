{
  "name": "@rbx/battle-pass",
  "version": "0.1.0",
  "description": "Seasonal battle pass with tiers, XP, and reward tracks",
  "private": true,
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rbx/core": "workspace:*",
    "@rbx/observability": "workspace:*",
    "@rbx/rewards": "workspace:*"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.906",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
