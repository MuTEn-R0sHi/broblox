{
  "name": "@rbx/security",
  "version": "0.0.0",
  "description": "Security utilities for Roblox games",
  "private": true,
  "main": "out",
  "types": "out",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "test": "vitest run --passWithNoTests"
  },
  "files": [
    "out/**/*"
  ],
  "keywords": [
    "roblox",
    "roblox-ts",
    "security",
    "anticheat"
  ],
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.849",
    "roblox-ts": "^3.0.0",
    "typescript": "5.8.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@rbx/core": "workspace:*",
    "@rbx/shared-types": "workspace:*"
  }
}
