{
  "name": "@broblox/security",
  "version": "0.2.0",
  "description": "Security utilities for Roblox games",
  "private": true,
  "status": "integrated",
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run"
  },
  "files": [
    "out/**/*"
  ],
  "keywords": [
    "roblox",
    "roblox-ts",
    "security",
    "anticheat"
  ],
  "devDependencies": {
    "@broblox/testing": "workspace:*",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.911",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@broblox/constants": "workspace:*",
    "@broblox/core": "workspace:*",
    "@broblox/shared-types": "workspace:*"
  },
  "license": "MIT"
}
