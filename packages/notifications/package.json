{
  "name": "@broblox/notifications",
  "version": "0.1.0",
  "description": "In-game notification system — toasts, announcements, and news for Roblox games",
  "private": true,
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run"
  },
  "keywords": [
    "roblox",
    "roblox-ts",
    "notifications",
    "toasts",
    "announcements"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.909",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@broblox/testing": "workspace:*"
  },
  "dependencies": {
    "@broblox/core": "workspace:*",
    "@broblox/observability": "workspace:*",
    "@broblox/shared-types": "workspace:*"
  }
}
