{
  "name": "@broblox/config-featureflags",
  "version": "0.2.0",
  "description": "Runtime feature flags and configuration management",
  "private": true,
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run"
  },
  "dependencies": {
    "@broblox/core": "workspace:*"
  },
  "devDependencies": {
    "@broblox/testing": "workspace:*",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.919",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
