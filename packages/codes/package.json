{
  "name": "@rbx/codes",
  "version": "0.1.0",
  "description": "Redeemable promo code system for Roblox games",
  "private": true,
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "roblox",
    "roblox-ts",
    "codes",
    "promo",
    "redemption"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.906",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@rbx/core": "workspace:*",
    "@rbx/observability": "workspace:*",
    "@rbx/shared-types": "workspace:*"
  }
}
