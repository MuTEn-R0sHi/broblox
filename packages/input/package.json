{
  "name": "@rbx/input",
  "version": "0.2.0",
  "private": true,
  "description": "Input abstraction for Roblox games - unified keyboard, gamepad, and touch controls",
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.906",
    "roblox-ts": "^3.0.0"
  }
}
