{
  "name": "@rbx/movement",
  "version": "0.1.0",
  "description": "Server-authoritative movement system for Roblox games",
  "main": "out/init.lua",
  "scripts": {
    "build": "rbxtsc",
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "watch": "rbxtsc -w",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "keywords": [
    "roblox",
    "movement",
    "networking",
    "anti-cheat",
    "roblox-ts"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.841",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@rbx/core": "workspace:*",
    "@rbx/net": "workspace:*",
    "@rbx/security": "workspace:*",
    "@rbx/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "@rbxts/compiler-types": "3.x",
    "@rbxts/types": "^1.0.0"
  }
}
