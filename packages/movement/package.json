{
  "name": "@rbx/movement",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative movement system for Roblox games",
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run"
  },
  "keywords": [
    "roblox",
    "movement",
    "networking",
    "anti-cheat",
    "roblox-ts"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.908",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@rbx/testing": "workspace:*"
  },
  "dependencies": {
    "@rbx/core": "workspace:*",
    "@rbx/observability": "workspace:*",
    "@rbx/shared-types": "workspace:*"
  }
}
