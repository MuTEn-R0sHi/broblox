{
  "name": "@broblox/ui",
  "version": "0.2.0",
  "private": true,
  "status": "integrated",
  "description": "UI component library for Roblox games",
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.908",
    "roblox-ts": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@broblox/testing": "workspace:*"
  },
  "dependencies": {
    "@broblox/audio": "workspace:*",
    "@broblox/battle-pass": "workspace:*",
    "@broblox/core": "workspace:*",
    "@broblox/cosmetics": "workspace:*",
    "@broblox/gacha": "workspace:*",
    "@broblox/input": "workspace:*",
    "@broblox/inventory": "workspace:*",
    "@broblox/pets": "workspace:*",
    "@broblox/quests": "workspace:*",
    "@broblox/rewards": "workspace:*",
    "@broblox/shared-types": "workspace:*"
  }
}
