{
  "name": "@rbx/data",
  "version": "0.0.0",
  "description": "Data persistence layer for Roblox games",
  "private": true,
  "main": "out",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out"
    }
  },
  "scripts": {
    "build:roblox": "rbxtsc -p tsconfig.roblox.json --type package",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude --type package",
    "test": "vitest run --passWithNoTests"
  },
  "files": [
    "out/**/*"
  ],
  "keywords": [
    "roblox",
    "roblox-ts",
    "data",
    "persistence",
    "datastore"
  ],
  "devDependencies": {
    "@rbx/testing": "workspace:*",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.849",
    "roblox-ts": "^3.0.0",
    "typescript": "5.8.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@rbx/core": "workspace:*",
    "@rbx/shared-types": "workspace:*"
  }
}
