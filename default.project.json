{
  "name": "rbx-game-platform",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "shared": {
        "$path": "games/starter/out/games/starter/src/shared"
      },
      "packages": {
        "$className": "Folder",
        "shared-types": {
          "src": {
            "$path": "games/starter/out/packages/shared-types/src"
          }
        },
        "core": {
          "src": {
            "$path": "games/starter/out/packages/core/src"
          }
        },
        "config-featureflags": {
          "src": {
            "$path": "games/starter/out/packages/config-featureflags/src"
          }
        },
        "net": {
          "src": {
            "$path": "games/starter/out/packages/net/src"
          }
        }
      },
      "rbxts_include": {
        "$path": "games/starter/include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "games/starter/node_modules/@rbxts"
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "server": {
        "$path": "games/starter/out/games/starter/src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "client": {
          "$path": "games/starter/out/games/starter/src/client"
        }
      }
    }
  }
}
