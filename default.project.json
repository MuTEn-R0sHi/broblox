{
  "name": "rbx-game-platform",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "shared": {
        "$path": "games/starter/out/shared"
      },
      "packages": {
        "$className": "Folder",
        "shared-types": {
          "$className": "Folder",
          "out": {
            "$path": "packages/shared-types/out"
          }
        },
        "core": {
          "$className": "Folder",
          "out": {
            "$path": "packages/core/out"
          }
        },
        "config-featureflags": {
          "$className": "Folder",
          "out": {
            "$path": "packages/config-featureflags/out"
          }
        },
        "net": {
          "$className": "Folder",
          "out": {
            "$path": "packages/net/out"
          }
        }
      },
      "rbxts_include": {
        "$path": "games/starter/include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "games/starter/node_modules/@rbxts"
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "server": {
        "$path": "games/starter/out/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "client": {
          "$path": "games/starter/out/client"
        }
      }
    }
  }
}
