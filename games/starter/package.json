{
  "name": "@broblox/game-starter",
  "version": "0.1.0",
  "description": "Starter game template using rbx-game-platform",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude",
    "build": "rbxtsc -p tsconfig.roblox.json --type game",
    "dev": "rbxtsc -p tsconfig.roblox.json -w --type game",
    "rojo:serve": "rojo serve default.project.json",
    "rojo:build": "rojo build default.project.json -o build.rbxl",
    "test": "vitest run"
  },
  "dependencies": {
    "@broblox/analytics": "workspace:*",
    "@broblox/audio": "workspace:*",
    "@broblox/battle-pass": "workspace:*",
    "@broblox/codes": "workspace:*",
    "@broblox/config-featureflags": "workspace:*",
    "@broblox/constants": "workspace:*",
    "@broblox/core": "workspace:*",
    "@broblox/cosmetics": "workspace:*",
    "@broblox/data": "workspace:*",
    "@broblox/events": "workspace:*",
    "@broblox/gacha": "workspace:*",
    "@broblox/input": "workspace:*",
    "@broblox/inventory": "workspace:*",
    "@broblox/leaderboards": "workspace:*",
    "@broblox/localization": "workspace:*",
    "@broblox/moderation": "workspace:*",
    "@broblox/movement": "workspace:*",
    "@broblox/net": "workspace:*",
    "@broblox/notifications": "workspace:*",
    "@broblox/observability": "workspace:*",
    "@broblox/pets": "workspace:*",
    "@broblox/progression": "workspace:*",
    "@broblox/quests": "workspace:*",
    "@broblox/rewards": "workspace:*",
    "@broblox/security": "workspace:*",
    "@broblox/shared-types": "workspace:*",
    "@broblox/tutorial": "workspace:*",
    "@broblox/ui": "workspace:*",
    "@broblox/world-systems": "workspace:*",
    "@rbxts/t": "^3.2.1"
  },
  "devDependencies": {
    "@broblox/testing": "workspace:*",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/services": "^1.6.0",
    "@rbxts/types": "^1.0.909",
    "roblox-ts": "^3.0.0"
  }
}
