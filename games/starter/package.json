{
  "name": "@rbx/game-starter",
  "version": "0.1.0",
  "description": "Starter game template using rbx-game-platform",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "rbxtsc -p tsconfig.roblox.json --noInclude",
    "build": "rbxtsc -p tsconfig.roblox.json --type game",
    "dev": "rbxtsc -p tsconfig.roblox.json -w --type game",
    "rojo:serve": "rojo serve default.project.json",
    "rojo:build": "rojo build default.project.json -o build.rbxl",
    "test": "vitest run"
  },
  "dependencies": {
    "@rbx/config-featureflags": "workspace:*",
    "@rbx/analytics": "workspace:*",
    "@rbx/codes": "workspace:*",
    "@rbx/constants": "workspace:*",
    "@rbx/leaderboards": "workspace:*",
    "@rbx/core": "workspace:*",
    "@rbx/security": "workspace:*",
    "@rbx/movement": "workspace:*",
    "@rbx/moderation": "workspace:*",
    "@rbx/net": "workspace:*",
    "@rbx/notifications": "workspace:*",
    "@rbx/progression": "workspace:*",
    "@rbx/quests": "workspace:*",
    "@rbx/rewards": "workspace:*",
    "@rbx/pets": "workspace:*",
    "@rbx/gacha": "workspace:*",
    "@rbx/inventory": "workspace:*",
    "@rbx/cosmetics": "workspace:*",
    "@rbx/battle-pass": "workspace:*",
    "@rbx/localization": "workspace:*",
    "@rbx/audio": "workspace:*",
    "@rbx/tutorial": "workspace:*",
    "@rbx/world-systems": "workspace:*",
    "@rbx/shared-types": "workspace:*",
    "@rbxts/t": "^3.2.1"
  },
  "devDependencies": {
    "@rbx/testing": "workspace:*",
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/services": "^1.6.0",
    "@rbxts/types": "^1.0.908",
    "roblox-ts": "^3.0.0"
  }
}
