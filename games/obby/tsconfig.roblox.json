{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "strict": true,

    "noLib": true,
    "module": "commonjs",
    "moduleResolution": "Node",
    "moduleDetection": "force",
    "allowSyntheticDefaultImports": true,
    "preserveSymlinks": true,

    "typeRoots": ["./node_modules/@rbxts", "./node_modules/@broblox"],
    "types": ["types", "compiler-types"],

    "rootDir": "src",
    "outDir": "out",

    "baseUrl": "src",
    "paths": {
      "shared/*": ["shared/*"],
      "@broblox/game-shared": ["../../packages/game-shared/src"],
      "@broblox/*": ["../node_modules/@broblox/*"]
    }
  },
  "rbxts": {
    "includePath": "include",
    "rojo": "default.project.json"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/@broblox/*/src/**", "**/*.test.ts", "**/__test-*", "**/__tests__/**"]
}
