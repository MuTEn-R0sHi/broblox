# No environment variables are required to run the website.
# The site is fully static at build time.

# --- Roblox game deep links ---
# Direct "Play" button URLs for each game.
# Find in Roblox Studio > Share, or from the game page URL.
# Example: https://www.roblox.com/games/12345678/BroBlox-Obby
NEXT_PUBLIC_ROBLOX_GAME_URL_OBBY=""
NEXT_PUBLIC_ROBLOX_GAME_URL_STARTER=""

# --- Roblox Open Cloud (optional) ---
# Used for live player counts on the Rankings page.
# Get your API key at: https://create.roblox.com/credentials
# Permissions needed: universe:read
# Universe IDs are found in the Roblox game page URL.
ROBLOX_API_KEY=""
NEXT_PUBLIC_ROBLOX_UNIVERSE_ID_OBBY="9624221556"
NEXT_PUBLIC_ROBLOX_UNIVERSE_ID_STARTER="9617061511"
