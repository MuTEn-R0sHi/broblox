# No environment variables are required to run the website.
# The site is fully static at build time.

# --- Future use ---

# Roblox game place IDs (for direct "Play" deep links)
# Find in Roblox Studio > Game Settings > Basic Info
# NEXT_PUBLIC_ROBLOX_GAME_ID_OBBY=""
# NEXT_PUBLIC_ROBLOX_GAME_ID_STARTER=""

# Show live player counts via Roblox Open Cloud API (optional)
# https://create.roblox.com/docs/cloud/open-cloud
# ROBLOX_API_KEY=""
# ROBLOX_UNIVERSE_ID_OBBY=""
# ROBLOX_UNIVERSE_ID_STARTER=""
