# Database (MySQL at lima-city)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://username:password@your-host.lima-city.de:3306/database_name"

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Production URL (required for OAuth redirects in production)
# Set this to your Vercel deployment URL
AUTH_URL="https://your-app.vercel.app"

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000 (or your production URL)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Optional: Restrict access to specific GitHub users (comma-separated)
# Leave empty to allow any GitHub user to sign in
ALLOWED_GITHUB_USERS=""

# Optional: Bootstrap ADMIN role for initial setup (comma-separated GitHub usernames)
# This avoids getting stuck with a default VIEWER user and no way to grant roles.
ADMIN_GITHUB_USERS=""

# Optional: API key for game servers to fetch flags
# Generate with: openssl rand -base64 32
# Leave empty to allow public access (not recommended for production)
FLAGS_API_KEY=""
