// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // RBAC
  role          Role      @default(VIEWER)

  // Audit
  auditLogs     AuditLog[]

  // Moderation relations
  bansIssued    Ban[]     @relation("BansIssued")
  bansRevoked   Ban[]     @relation("BansRevoked")
  mutesIssued   Mute[]    @relation("MutesIssued")
  evidenceUploaded Evidence[]
  appealsResolved Appeal[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// RBAC Roles
enum Role {
  VIEWER
  SUPPORT
  MODERATOR
  ENGINEER
  ADMIN
}

// Audit logging
model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  action    String   // e.g., "config.update", "ban.create"
  target    String?  // e.g., player ID, config key
  before    Json?    // State before change
  after     Json?    // State after change
  reason    String?  // Required for bans and prod actions

  ipHash    String?  // Privacy-safe IP hash
  userAgent String?  @db.Text

  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

// ============================================================================
// Moderation System
// ============================================================================

enum BanType {
  TEMPORARY
  PERMANENT
}

enum BanStatus {
  ACTIVE
  EXPIRED
  REVOKED
  APPEALED
}

enum MuteType {
  CHAT
  VOICE
  ALL
}

model Ban {
  id          String    @id @default(cuid())

  playerId    BigInt    // Roblox UserId
  playerName  String?   // Cached display name

  type        BanType   @default(TEMPORARY)
  status      BanStatus @default(ACTIVE)

  reason      String    @db.Text
  internalNote String?  @db.Text  // Staff-only notes

  // Duration (null = permanent)
  durationHours Int?
  expiresAt   DateTime?

  // Moderator who issued the ban
  issuedById  String
  issuedBy    User      @relation("BansIssued", fields: [issuedById], references: [id])

  // Revocation details
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("BansRevoked", fields: [revokedById], references: [id])
  revokeReason String?  @db.Text

  // Evidence
  evidence    Evidence[]

  // Appeals
  appeals     Appeal[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([playerId])
  @@index([status])
  @@index([expiresAt])
  @@index([issuedById])
}

model Mute {
  id          String    @id @default(cuid())

  playerId    BigInt    // Roblox UserId
  playerName  String?   // Cached display name

  type        MuteType  @default(CHAT)
  isActive    Boolean   @default(true)

  reason      String    @db.Text

  // Duration
  durationMinutes Int
  expiresAt   DateTime

  // Moderator who issued the mute
  issuedById  String
  issuedBy    User      @relation("MutesIssued", fields: [issuedById], references: [id])

  createdAt   DateTime  @default(now())

  @@index([playerId])
  @@index([isActive])
  @@index([expiresAt])
}

model Evidence {
  id          String    @id @default(cuid())

  banId       String
  ban         Ban       @relation(fields: [banId], references: [id], onDelete: Cascade)

  type        String    // "text", "screenshot", "video", "log"
  content     String    @db.Text  // Text content or URL
  description String?

  uploadedById String
  uploadedBy  User      @relation(fields: [uploadedById], references: [id])

  createdAt   DateTime  @default(now())

  @@index([banId])
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

model Appeal {
  id          String       @id @default(cuid())

  banId       String
  ban         Ban          @relation(fields: [banId], references: [id], onDelete: Cascade)

  playerId    BigInt       // Roblox UserId (for verification)
  playerName  String?

  status      AppealStatus @default(PENDING)
  reason      String       @db.Text  // Player's appeal reason

  // Resolution
  resolvedAt  DateTime?
  resolvedById String?
  resolvedBy  User?        @relation(fields: [resolvedById], references: [id])
  resolution  String?      @db.Text

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([banId])
  @@index([status])
  @@index([playerId])
}

// Feature flags configuration
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text

  // Per-environment toggles
  enabledDev   Boolean @default(false)
  enabledStage Boolean @default(false)
  enabledProd  Boolean @default(false)

  // Rollout configuration
  rolloutPercentage Int      @default(100)  // 0-100
  segments          Json?    // Array of segment IDs

  // Scheduling
  startsAt     DateTime?
  endsAt       DateTime?

  // Kill switch (overrides everything)
  isKilled     Boolean  @default(false)
  killedAt     DateTime?
  killedById   String?

  value       Json?    // Optional JSON value for complex flags

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Match history
enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ERRORED
}

enum MatchOutcome {
  TEAM_A_WIN
  TEAM_B_WIN
  DRAW
  CANCELLED
  INCOMPLETE
}

model Match {
  id           String      @id @default(cuid())
  matchId      String      @unique  // Game-generated match ID
  serverId     String?     // Roblox server JobId
  placeId      BigInt?     // Roblox place ID

  gameMode     String      // e.g., "deathmatch", "ctf", "ranked"
  mapName      String?

  status       MatchStatus @default(PENDING)
  outcome      MatchOutcome?

  // Timing
  startedAt    DateTime?
  endedAt      DateTime?
  durationSecs Int?

  // Scores
  teamAScore   Int         @default(0)
  teamBScore   Int         @default(0)

  // Metadata
  metadata     Json?       // Additional match data (settings, etc.)

  // Relations
  players      MatchPlayer[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([gameMode])
  @@index([startedAt])
  @@index([createdAt])
}

model MatchPlayer {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playerId    BigInt   // Roblox UserId
  playerName  String?  // Cached display name

  team        String?  // "A", "B", or null for FFA
  isWinner    Boolean  @default(false)

  // Stats
  kills       Int      @default(0)
  deaths      Int      @default(0)
  assists     Int      @default(0)
  score       Int      @default(0)

  // Timing
  joinedAt    DateTime @default(now())
  leftAt      DateTime?

  // Additional stats
  stats       Json?    // Game-specific stats

  @@unique([matchId, playerId])
  @@index([playerId])
}

// ============================================================================
// Telemetry & Metrics (ingested from game servers)
// ============================================================================

model TelemetryEvent {
  id          String   @id @default(cuid())

  category    String   // game, player, match, economy, etc.
  name        String   // e.g., "player_joined", "match_started"
  level       String   // debug, info, warn, error

  timestamp   Int      // Unix timestamp from game server (os.time())
  clock       Float    // High-precision clock (os.clock())

  // Correlation
  traceId     String?
  spanId      String?
  serverId    String?
  placeId     BigInt?
  playerId    BigInt?
  sessionId   String?

  // Event-specific data
  data        Json?

  // Ingestion metadata
  ingestedAt  DateTime @default(now())

  @@index([category, name])
  @@index([level])
  @@index([timestamp])
  @@index([playerId])
  @@index([serverId])
  @@index([ingestedAt])
}

model MetricPoint {
  id          String   @id @default(cuid())

  name        String   // Metric name (e.g., "player_count", "frame_time_ms")
  type        String   // counter, gauge, histogram

  value       Float
  timestamp   Int      // Unix timestamp from game server

  // Labels for dimensional filtering
  labels      Json?    // { "server": "abc", "gameMode": "ffa" }

  // Ingestion metadata
  serverId    String?
  ingestedAt  DateTime @default(now())

  @@index([name, timestamp])
  @@index([type])
  @@index([serverId])
  @@index([ingestedAt])
}
