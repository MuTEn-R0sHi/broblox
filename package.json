{
  "name": "rbx-game-platform",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",

    "game:starter:build": "pnpm --filter @rbx/game-starter run build",
    "game:starter:dev": "pnpm --filter @rbx/game-starter run dev",
    "game:starter:rojo": "pnpm --filter @rbx/game-starter run rojo:serve"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.0.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.0.17"
  }
}
