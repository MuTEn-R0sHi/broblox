{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "strict": true,
    "noLib": true,
    "downlevelIteration": true,
    "module": "commonjs",
    "moduleResolution": "Node",
    "moduleDetection": "force",
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./node_modules/@rbxts", "./node_modules/@broblox"],
    "types": ["types", "compiler-types"],
    "rootDir": ".",
    "outDir": "out",
    "paths": {
      "@broblox/shared-types": ["./packages/shared-types/src/index.ts"],
      "@broblox/constants": ["./packages/constants/src/index.ts"],
      "@broblox/core": ["./packages/core/src/index.ts"],
      "@broblox/config-featureflags": ["./packages/config-featureflags/src/index.ts"],
      "@broblox/net": ["./packages/net/src/index.ts"],
      "@broblox/data": ["./packages/data/src/index.ts"],
      "@broblox/security": ["./packages/security/src/index.ts"],
      "@broblox/observability": ["./packages/observability/src/index.ts"],
      "@broblox/combat": ["./packages/combat/src/index.ts"],
      "@broblox/matchmaking": ["./packages/matchmaking/src/index.ts"],
      "@broblox/moderation": ["./packages/moderation/src/index.ts"],
      "@broblox/movement": ["./packages/movement/src/index.ts"],
      "@broblox/input": ["./packages/input/src/index.ts"],
      "@broblox/ui": ["./packages/ui/src/index.ts"],
      "@broblox/codes": ["./packages/codes/src/index.ts"],
      "@broblox/leaderboards": ["./packages/leaderboards/src/index.ts"],
      "@broblox/analytics": ["./packages/analytics/src/index.ts"],
      "@broblox/notifications": ["./packages/notifications/src/index.ts"],
      "@broblox/inventory": ["./packages/inventory/src/index.ts"],
      "@broblox/progression": ["./packages/progression/src/index.ts"],
      "@broblox/quests": ["./packages/quests/src/index.ts"],
      "@broblox/rewards": ["./packages/rewards/src/index.ts"],
      "@broblox/pets": ["./packages/pets/src/index.ts"],
      "@broblox/gacha": ["./packages/gacha/src/index.ts"],
      "@broblox/cosmetics": ["./packages/cosmetics/src/index.ts"],
      "@broblox/battle-pass": ["./packages/battle-pass/src/index.ts"],
      "@broblox/localization": ["./packages/localization/src/index.ts"],
      "@broblox/audio": ["./packages/audio/src/index.ts"],
      "@broblox/tutorial": ["./packages/tutorial/src/index.ts"],
      "@broblox/world-systems": ["./packages/world-systems/src/index.ts"],
      "@broblox/events": ["./packages/events/src/index.ts"],
      "@broblox/marketplace": ["./packages/marketplace/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
